!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
.venv/*
.venv-312-beta/*
/.esphome-venvs/
/.act/
# CodeQL artifacts
_codeql_detected_source_root
.http_server.pid
.local_dev_state
src/common/homeassistant_dev.yaml

# Simulator Build-Artefakte
tests/simulator/.esphome/
.vscode/settings.json
